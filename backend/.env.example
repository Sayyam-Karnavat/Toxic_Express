# Copy to .env and fill in. Never commit .env.
ENV=dev
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]

DATABASE_URL=postgresql+asyncpg://toxic:toxic@localhost:5433/toxic_express
# Set true when using Neon's pooled (PgBouncer) connection string
DB_USE_PGBOUNCER=false
REDIS_URL=redis://localhost:6380/0

# openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web application)
# Authorised redirect URI (dev goes through the Vite proxy): http://localhost:5173/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/google/callback

# Cloudflare R2 (prod) or the local SeaweedFS from docker-compose (dev)
S3_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY=devaccesskey
S3_SECRET_KEY=devsecretkey123
S3_REGION=auto
S3_BUCKET_RAW=te-uploads-raw
S3_BUCKET_PUBLIC=te-media-public
MEDIA_PUBLIC_BASE_URL=http://localhost:8333/te-media-public
MEDIA_MIN_ACCOUNT_AGE_HOURS=24
MEDIA_REQUIRE_VERIFIED_EMAIL=true

# Free: https://platform.openai.com/api-keys (omni-moderation is free). Required in prod.
OPENAI_API_KEY=

# https://resend.com (free 3k/month). Empty = emails are printed to the API/worker log.
RESEND_API_KEY=
EMAIL_FROM=Toxic-Express <no-reply@your-domain.com>

SENTRY_DSN=
